# Secreto usado para firmar la cookie de sesión. Genera uno propio, por
# ejemplo con: openssl rand -base64 32
SESSION_SECRET=

# Ruta del archivo SQLite. En Docker debe apuntar al volumen persistente
# (ver Dockerfile / docker-compose). En desarrollo local, el valor por
# defecto (./data/app.db) funciona sin configurar nada.
DATABASE_PATH=./data/app.db

# SMTP para el backup semanal por correo a la jefa (sección 10.1 de la
# especificación). Opcional: si se deja vacío, el backup por correo
# simplemente no se envía (el resto de la app funciona igual).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BACKUP_EMAIL_TO=
