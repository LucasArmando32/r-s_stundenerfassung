# Supabase (self-hosted vía Dokploy). Estos valores salen del panel de
# Supabase Studio de tu instancia -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://supabase.tu-dominio.ch
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: solo se usa en el servidor (Server Actions / route
# handlers), nunca se expone al navegador. Necesaria para crear/desactivar
# cuentas de trabajadores desde /admin/trabajadores.
SUPABASE_SERVICE_ROLE_KEY=
